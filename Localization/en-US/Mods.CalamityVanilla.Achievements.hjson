HiveMindKilled: {
	FriendlyName: Heed the Swarm
	Description: Defeat the Hive Mind, the mycelial mastermind behind the sickly corruption's fungi.
}

CryogenKilled: {
	FriendlyName: Breaking the Ice
	Description: Defeat Cryogen, the arctic fortress protected by a magic spell.
}

GutOfCthulhuKilled: {
	FriendlyName: Impromptu Colonoscopy
	Description: Defeat the Gut of Cthulhu, the Crimson's raging stomach with a parasite problem.
}

ThrowBrickAtGlass: {
	FriendlyName: Watch Where You're Throwing That!
	Description: Lob a throwing brick at some glass or thin ice. Don't forget to clean up the mess!
}

TerraGlobeObtained: {
	FriendlyName: Spell of the Hero
	Description: Obtain the Globe of Terra, forged from the finest spells from around the globe.
}

TerraLongbowObtained: {
	FriendlyName: Bow of the Hero
	Description: Obtain the Terra Longbow, forged from the finest bows of dawn and dusk.
}

PriestGetBlessing: {
	FriendlyName: Blessing in Disguise
	Description: Become empowered by one of the Priest's many strange blessings.
}
