Moleman: {
	DisplayName: Moleman
	Description: "Like the lowly mole, the underground has become your sanctuary!\nYour arms and legs have adapted to the damp caves, but in turn\nyou've become blind as a bat on the surface."
	Stats:
		'''
		[c/32FF82:While underground:]
		[c/32FF82:+25% Mining speed]
		[c/32FF82:+15% Movement speed]
		[c/32FF82:+75% Acceleration]
		[c/E11919:Blinded on surface]
		'''
}

